name = "praise-support"
main = "src/worker.js"
compatibility_date = "2026-09-01"

# Optional, but recommended for production rate limiting across isolates.
# Create with:
#   wrangler kv namespace create PRAISE_SUPPORT_RATE_LIMIT
#
# [[kv_namespaces]]
# binding = "RATE_LIMIT"
# id = "REPLACE_WITH_KV_NAMESPACE_ID"

[vars]
GITHUB_REPOSITORY = "nani-samireddy/praise"
RATE_LIMIT_PER_HOUR = "3"

# Set as secrets, never plain vars:
#   wrangler secret put DISCORD_SONG_REQUESTS_WEBHOOK_URL
#   wrangler secret put DISCORD_APP_REPORTS_WEBHOOK_URL
#   wrangler secret put APPSHEET_DEPLOY_TOKEN
#   wrangler secret put GITHUB_DISPATCH_TOKEN
#
# Optional fallback for older single-channel deployments:
#   wrangler secret put DISCORD_WEBHOOK_URL
