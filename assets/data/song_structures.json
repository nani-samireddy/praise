      {
        "id":"verse-1","type":"verse","number":1,"label":"Verse 1",
        "lines":[
          {"text":"అవమానం ఎంతైనా – నా వారే కాదన్నా","transliteration":"Avamaanam Enthainaa – Naa Vaare Kaadannaa","chords":[{"at":0,"chord":"Em"},{"at":10,"chord":"C"},{"at":22,"chord":"Em"},{"at":30,"chord":"C"}]},
          {"text":"నీవు తప్ప ఎవరున్నారు ఆకాశమందున","transliteration":"Neevu Thappa Evarunnaaru Aakaashamanduna","repeatCount":2,"chords":[{"at":0,"chord":"D"},{"at":12,"chord":"Am"},{"at":26,"chord":"D"},{"at":34,"chord":"Em"}]},
          {"text":"నీవు నాకుండగా – ఏది నాకక్కర లేదు","transliteration":"Neevu Naakundagaa – Edi Naakakkara Ledu","repeatCount":2,"chords":[{"at":0,"chord":"A"},{"at":20,"chord":"Em"}]}
