        "lines": [
          {"text":"అంతా నా మేలుకే – ఆరాధన యేసుకే","transliteration":"Anthaa Naa Meluke – Aaraadhana Yesuke","chords":[{"at":0,"chord":"Em"},{"at":9,"chord":"C"},{"at":19,"chord":"Em"},{"at":30,"chord":"D"}]},
          {"text":"అంతా నా మంచికే – తన చిత్తమునకు తల వంచితే","transliteration":"Anthaa Naa Manchike – Thana Chitthamunaku Thala Vanchithe","chords":[{"at":0,"chord":"Am"},{"at":10,"chord":"C"},{"at":27,"chord":"D"},{"at":45,"chord":"Em"}]},
          {"text":"తన చిత్తమునకు తల వంచితే","transliteration":"Thana Chitthamunaku Thala Vanchithe","chords":[{"at":0,"chord":"C"},{"at":18,"chord":"Em"}]},
          {"text":"ఆరాధన ఆపను – స్తుతియించుట మానను","transliteration":"Aaraadhana Aapanu – Stuthiyinchuta Maananu","repeatCount":2,"chords":[{"at":0,"chord":"C"},{"at":10,"chord":"Em"},{"at":25,"chord":"D"}]},
          {"text":"స్తుతియించుట మానను","transliteration":"Stuthiyinchuta Maananu","chords":[{"at":0,"chord":"C"},{"at":15,"chord":"Em"}]}
        ]
